server {
    listen {{ http_port }};
    server_name {{ domain_name }};
    return 301 https://$host$request_uri;
}

server {
	listen {{ https_port }} ssl;
	server_name {{ domain_name }};
	
	ssl_protocols TLSv1.3;
	ssl_certificate {{ container_certs_dir }}/cert.pem;
	ssl_certificate_key {{ container_certs_dir }}/cert.key;
	
	index index.php;
	root {{ html_dir }};

	location / {
		try_files $uri $uri/ /index.php$is_args$args;
	}

	location ~ \.php$ {
		include snippets/fastcgi-php.conf;
		fastcgi_pass {{ wordpress_container_name }}:{{ php_fpm_port }};
	}
}